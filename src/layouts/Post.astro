---
import Base from "./Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { css } from "../../styled-system/css";
import { getIconSvg } from "../utils/icons";
import { resolveTagIcon, type TagIconEntry } from "../utils/tagIcons";
import { getLangFromUrl } from "../i18n";
import { formatDate } from "../utils/formatDate";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  tagIcons?: Record<string, TagIconEntry>;
  ogImage?: string;
  translationUrl?: string;
  translationLang?: "en" | "fr";
}

const { title, description, date, tags = [], tagIcons, ogImage, translationUrl, translationLang } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const formattedDate = date ? formatDate(date, lang) : null;
const translationLabel = translationLang === "fr" ? "Lire en français" : "Read in English";
---

<Base title={title} description={description} ogImage={ogImage}>
  <Header />
  <main class={css({ px: "clamp(14px, 4vw, 40px)" })}>
    <div class={css({ maxW: "container", mx: "auto", py: "12" })}>
      <header class={css({ mb: "10", pb: "8", borderBottom: "1px solid", borderBottomColor: "border" })}>
        {formattedDate && (
          <p class={css({ textStyle: "label", color: "textMuted", mb: "3" })}>{formattedDate}</p>
        )}
        <h1 class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "clamp(1.5rem, 4vw, 2rem)", lineHeight: "1.2", letterSpacing: "-0.02em", mb: "3" })}>
          {title}
        </h1>
        {description && (
          <p class={css({ textStyle: "body", color: "textMuted", fontSize: "1rem", lineHeight: "1.55" })}>{description}</p>
        )}
        {tags.length > 0 && (
          <div class={css({ display: "flex", gap: "3", mt: "4", flexWrap: "wrap" })}>
            {tags.map(tag => {
              const iconInfo = resolveTagIcon(tag, tagIcons);
              return (
                <span class={css({ display: "inline-flex", alignItems: "center", gap: "1", textStyle: "label", color: "textMuted" })}>
                  {iconInfo && <span set:html={getIconSvg(iconInfo.icon, iconInfo.iconSource, 13)} />}
                  {tag}
                </span>
              );
            })}
          </div>
        )}
        {translationUrl && (
          <a
            href={translationUrl}
            class={css({ display: "inline-block", mt: "4", textStyle: "label", color: "textMuted", borderBottom: "1px dashed", borderBottomColor: "border", _hover: { color: "text", borderBottomColor: "text" } })}
          >
            {translationLabel} →
          </a>
        )}
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</Base>
