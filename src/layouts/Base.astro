---
import "../styles/global.css";
import { cleanPath, getLangFromUrl, getThemePath, type Theme } from "../i18n";
import { underConstruction } from "../utils/construction";
import { site, socials } from "../data/site";
import UnderConstruction from "../themes/modern/views/UnderConstruction.astro";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  canonicalURL?: string;
  theme?: Theme;
  // articles only, adds BlogPosting structured data
  published?: Date;
}

const {
  title,
  description: pageDescription,
  ogImage,
  theme: requestedTheme = "modern",
  published,
} = Astro.props;

const theme: Theme = underConstruction ? "modern" : requestedTheme;
const lang = getLangFromUrl(Astro.url);
const defaultDescription =
  lang === "fr"
    ? `${site.author}, ingénieur logiciel à ${site.location}. Blog & portfolio : logiciel, informatique, et ce qu'il y a en dessous.`
    : `${site.author}, software engineer in ${site.location}. Blog & portfolio: software, computing, and what's underneath.`;
const description = underConstruction ? defaultDescription : (pageDescription ?? defaultDescription);

const siteTitle = "s1m0n3rdx";
const isHome = title === siteTitle;
const homeTitle = lang === "fr" ? `${site.author} · Ingénieur logiciel à ${site.location}` : `${site.author} · Software Engineer in ${site.location}`;
const fullTitle = underConstruction ? siteTitle : isHome ? homeTitle : `${title} - ${siteTitle}`;
// every theme shows the same content: the manga version (root URLs) is the canonical one
const canonicalURL =
  Astro.props.canonicalURL ??
  new URL(getThemePath(cleanPath(Astro.url.pathname), "manga"), Astro.site ?? Astro.url).href;

// link previews need an absolute image URL
const ogImageURL = new URL(underConstruction || !ogImage ? "/og.png" : ogImage, Astro.site ?? Astro.url).href;
const ogLocale = lang === "fr" ? "fr_FR" : "en_US";

const siteURL = new URL("/", Astro.site ?? Astro.url).href;
const person = {
  "@type": "Person",
  name: site.author,
  alternateName: site.name,
  url: siteURL,
  jobTitle: lang === "fr" ? site.role_fr : site.role,
  address: { "@type": "PostalAddress", addressLocality: site.location, addressCountry: "SN" },
  sameAs: socials.filter(({ href }) => href.startsWith("https://")).map(({ href }) => href),
};
const jsonLd = underConstruction
  ? null
  : published
    ? {
        "@context": "https://schema.org",
        "@type": "BlogPosting",
        headline: title,
        description,
        datePublished: published.toISOString(),
        inLanguage: lang,
        image: ogImageURL,
        url: canonicalURL,
        author: person,
      }
    : isHome
      ? { "@context": "https://schema.org", ...person }
      : null;

const fonts = {
  modern: "https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&display=swap",
  classic: "https://fonts.googleapis.com/css2?family=Archivo+Black&family=IBM+Plex+Mono:wght@400;500;600;700&display=swap",
  manga: "https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700;800;900&family=Geist+Mono:wght@400;500;600&family=Dela+Gothic+One&display=swap",
};
---

<!doctype html>
<html lang={lang} data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {underConstruction && <meta name="robots" content="noindex" />}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={published ? "article" : "website"} />
    <meta property="og:site_name" content={siteTitle} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={siteTitle} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts[theme]} rel="stylesheet" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    {underConstruction ? <UnderConstruction /> : <slot />}
  </body>
</html>
