---
import { css } from "../../../styled-system/css";
import { getIconSvg } from "../../utils/icons";
import { stack } from "../../data/stack";
---

<div class={css({ py: "8", borderBottom: "1px solid", borderBottomColor: "border" })}>
  <p class={css({ textStyle: "eyebrow", fontWeight: "600", color: "textMuted", mb: "6" })}>stack</p>
  <div class={css({ display: "flex", flexDir: "column", gap: "5" })}>
    {stack.map(({ category, items }) => (
      <div class={css({ display: "flex", alignItems: "baseline", gap: "6" })}>
        <span class={css({ textStyle: "label", color: "textMuted", flexShrink: "0", w: "20" })}>{category}</span>
        <div class={css({ display: "flex", gap: "4", flexWrap: "wrap" })}>
          {items.map(({ label, icon, iconSource }) => (
            <span class={css({ display: "inline-flex", alignItems: "center", gap: "1", textStyle: "label", color: "textMuted" })}>
              <span set:html={getIconSvg(icon, iconSource)} />
              {label}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
