---
import { css } from "../../../styled-system/css";
import IconGithub from "iconoir/icons/regular/github.svg?raw";
---

<section class={css({ py: "16", borderBottom: "1px solid", borderBottomColor: "border" })}>
  <p class={css({ textStyle: "eyebrow", color: "textMuted" })}>s1m0n3rdx - software engineer</p>
  <h1 class={css({ textStyle: "giant", fontSize: "clamp(2.4rem, 7vw, 5.5rem)", mt: "4", mb: "6" })}>
    I build<br />things<span style="color: var(--colors-accent)">.</span>
  </h1>
  <a
    href="https://github.com/boysimon10"
    target="_blank"
    rel="noopener noreferrer"
    class={css({ display: "inline-flex", alignItems: "center", gap: "2", fontFamily: "mono", fontSize: "0.82rem", fontWeight: "500", border: "1.5px solid", borderColor: "text", px: "5", py: "3", rounded: "pill", _hover: { bg: "text", color: "surface" }, transition: "all 0.15s ease" })}
  >
    <span class={css({ w: "16px", h: "16px", display: "flex", alignItems: "center", flexShrink: "0" })} set:html={IconGithub} />
    github <span style="color: var(--colors-accent)">→</span>
  </a>
</section>
