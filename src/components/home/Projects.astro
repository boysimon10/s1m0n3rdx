---
import { css } from "../../../styled-system/css";
import { createElement } from "react";
import { renderToStaticMarkup } from "react-dom/server";
import * as DevIcons from "developer-icons";

type IconName = keyof typeof DevIcons;

function getIconSvg(name: IconName, size = 16): string {
  const Icon = DevIcons[name] as (props: { size: number }) => React.ReactElement;
  if (!Icon) return "";
  return renderToStaticMarkup(createElement(Icon, { size }));
}

const projects = [
  {
    num: "01",
    name: "Project A",
    desc: "Description courte du projet.",
    tags: [
      { label: "Go", icon: "Go" as IconName },
      { label: "GraphQL", icon: "GraphQL" as IconName },
    ],
    href: "#",
  },
  {
    num: "02",
    name: "Project B",
    desc: "Description courte du projet.",
    tags: [
      { label: "React Native", icon: "React" as IconName },
      { label: "NestJS", icon: "NestJS" as IconName },
    ],
    href: "#",
  },
  {
    num: "03",
    name: "Project C",
    desc: "Description courte du projet.",
    tags: [
      { label: "NestJS", icon: "NestJS" as IconName },
      { label: "GraphQL", icon: "GraphQL" as IconName },
    ],
    href: "#",
  },
];
---

<section class={css({ py: "12", borderBottom: "1px solid", borderBottomColor: "border" })}>
  <div class={css({ display: "flex", justifyContent: "space-between", alignItems: "baseline", mb: "8" })}>
    <p class={css({ textStyle: "eyebrow", color: "textMuted" })}>projets</p>
    <a href="/projects" class={css({ textStyle: "label", color: "textMuted", _hover: { color: "text" } })}>
      voir tout <span style="color: var(--colors-accent)">→</span>
    </a>
  </div>

  <div class={css({ display: "flex", flexDir: "column" })}>
    {projects.map(({ num, name, desc, tags, href }) => (
      <a
        href={href}
        class={css({ display: "flex", alignItems: "baseline", gap: "6", py: "5", borderBottom: "1px solid", borderBottomColor: "border", _hover: { opacity: "0.75" } })}
      >
        <span class={css({ textStyle: "label", color: "accent", flexShrink: "0" })}>{num}</span>
        <div class={css({ flex: "1", minW: "0" })}>
          <span class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "1rem" })}>{name}</span>
          <p class={css({ textStyle: "body", color: "textMuted", fontSize: "0.9rem", mt: "1" })}>{desc}</p>
        </div>
        <div class={css({ display: "flex", gap: "3", flexWrap: "wrap", flexShrink: "0" })}>
          {tags.map(({ label, icon }) => (
            <span class={css({ display: "inline-flex", alignItems: "center", gap: "1", textStyle: "label", color: "textMuted" })}>
              <span set:html={getIconSvg(icon)} />
              {label}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
