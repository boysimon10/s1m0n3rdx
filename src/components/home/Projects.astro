---
import { css } from "../../../styled-system/css";
import { projects } from "../../data/projects";
import { getIconSvg } from "../../utils/icons";
---

<section class={css({ py: "12" })}>
  <div class={css({ display: "flex", justifyContent: "space-between", alignItems: "baseline", mb: "8" })}>
    <p class={css({ textStyle: "eyebrow", fontWeight: "600", color: "textMuted" })}>projets</p>
    <a href="/projects" class={css({ textStyle: "label", color: "textMuted", _hover: { color: "text" } })}>
      voir tout <span style="color: var(--colors-accent)">→</span>
    </a>
  </div>

  <div class={css({ display: "flex", flexDir: "column" })}>
    {projects.map(({ num, name, desc, tags, href }) => (
      <a
        href={href}
        target="_blank"
        rel="noopener noreferrer"
        class={css({ display: "flex", alignItems: "baseline", gap: "6", py: "5", borderBottom: "1px solid", borderBottomColor: "border", _hover: { opacity: "0.75" } })}
      >
        <span class={css({ textStyle: "label", color: "accent", flexShrink: "0" })}>{num}</span>
        <div class={css({ flex: "1", minW: "0" })}>
          <span class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "1rem" })}>{name}</span>
          <p class={css({ textStyle: "body", color: "textMuted", fontSize: "0.9rem", mt: "1" })}>{desc}</p>
        </div>
        <div class={css({ display: "flex", gap: "3", flexWrap: "wrap", flexShrink: "0" })}>
          {tags.map(({ label, icon, iconSource }) => (
            <span class={css({ display: "inline-flex", alignItems: "center", gap: "1", textStyle: "label", color: "textMuted" })}>
              <span set:html={getIconSvg(icon, iconSource)} />
              {label}
            </span>
          ))}
        </div>
      </a>
    ))}
  </div>
</section>
