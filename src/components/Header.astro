---
import { css } from "../../styled-system/css";
import IconRss from "iconoir/icons/regular/rss-feed.svg?raw";
import { getLangFromUrl, useTranslations, getAlternatePath, getNavLinks } from "../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const navLinks = getNavLinks(lang);

const isActive = (href: string) =>
  href === "/" || href === "/fr"
    ? currentPath === href
    : currentPath === href || currentPath.startsWith(href + "/");

const enUrl = lang === "fr" ? getAlternatePath(currentPath, "en") : currentPath;
const frUrl = lang === "en" ? getAlternatePath(currentPath, "fr") : currentPath;
---

<header class={css({ py: "8", textAlign: "center" })}>

  <div class={css({ mb: "4" })}>
    <a href={lang === "fr" ? "/fr" : "/"}>
      <img
        src="https://avatars.githubusercontent.com/u/47926032?v=4"
        alt="s1m0n"
        width="48"
        height="48"
        class={css({ w: "48px", h: "48px", rounded: "full", mx: "auto", display: "block", _hover: { opacity: "0.8" } })}
      />
    </a>
  </div>

  <nav class={css({ display: "flex", alignItems: "center", justifyContent: "center", gap: "8", mb: "3" })}>
    {navLinks.map(({ labelKey, href }) => (
      <a
        href={href}
        class={css({
          fontFamily: "display",
          fontSize: "1.1rem",
          fontWeight: "700",
          color: "text",
          pb: "1px",
          borderBottom: isActive(href) ? "2px solid" : "2px solid transparent",
          borderBottomColor: isActive(href) ? "text" : "transparent",
          _hover: { borderBottomColor: "text" },
        })}
      >
        {t(labelKey)}
      </a>
    ))}
    <a
      href="/rss.xml"
      class={css({ display: "flex", alignItems: "center", color: "textMuted", _hover: { color: "text" } })}
      aria-label="RSS"
    >
      <span class={css({ w: "18px", h: "18px", display: "flex" })} set:html={IconRss} />
    </a>
  </nav>

  <div class={css({ display: "flex", alignItems: "center", justifyContent: "center", gap: "4" })}>
    <a href={enUrl} class={css({ textStyle: "label", color: lang === "en" ? "accent" : "textMuted", _hover: { color: "text" } })}>EN</a>
    <a href={frUrl} class={css({ textStyle: "label", color: lang === "fr" ? "accent" : "textMuted", _hover: { color: "text" } })}>FR</a>
  </div>

</header>
