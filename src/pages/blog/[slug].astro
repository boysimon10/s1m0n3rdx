---
import { render } from "astro:content";
import Post from "../../themes/manga/layouts/Post.astro";
import { getSlugFromId, localePath } from "../../i18n";
import { getVolumes } from "../../utils/volumes";

export async function getStaticPaths() {
  const volumes = await getVolumes("en");
  const others = await getVolumes("fr");
  // volumes are newest first: the next volume is the one before in the list.
  // Announced ones get no page; as a neighbor they show their title without a link.
  return volumes.flatMap(({ post, num, minutes, soon }, i) => {
    if (soon) return [];
    const translation = post.data.translationKey
      ? others.find((v) => !v.soon && v.post.data.translationKey === post.data.translationKey)
      : undefined;
    const link = (index: number) => {
      const v = volumes.at(index);
      if (!v || index < 0) return undefined;
      return { title: v.post.data.title, href: v.soon ? undefined : localePath("en", "manga", `/blog/${getSlugFromId(v.post.id)}`) };
    };
    return {
      params: { slug: getSlugFromId(post.id) },
      props: {
        post,
        num,
        minutes,
        prev: link(i + 1),
        next: link(i - 1),
        translationUrl: translation ? localePath("fr", "manga", `/blog/${getSlugFromId(translation.post.id)}`) : undefined,
      },
    };
  });
}

const { post, num, minutes, prev, next, translationUrl } = Astro.props;
const { Content, headings } = await render(post);
---

<Post
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage?.src}
  date={post.data.date}
  tags={post.data.tags}
  headings={headings}
  num={num}
  minutes={minutes}
  prev={prev}
  next={next}
  translationUrl={translationUrl}
>
  <Content />
</Post>
