---
import { render } from "astro:content";
import Post from "../../themes/manga/layouts/Post.astro";
import { getSlugFromId, localePath } from "../../i18n";
import { getVolumes } from "../../utils/volumes";

export async function getStaticPaths() {
  const volumes = await getVolumes("en");
  const others = await getVolumes("fr");
  // volumes are newest first: the next volume is the one before in the list
  return volumes.map(({ post, num, minutes }, i) => {
    const translation = post.data.translationKey ? others.find((v) => v.post.data.translationKey === post.data.translationKey) : undefined;
    const link = (index: number) => {
      const v = volumes.at(index);
      return v && index >= 0 ? { title: v.post.data.title, href: localePath("en", "manga", `/blog/${getSlugFromId(v.post.id)}`) } : undefined;
    };
    return {
      params: { slug: getSlugFromId(post.id) },
      props: {
        post,
        num,
        minutes,
        prev: link(i + 1),
        next: link(i - 1),
        translationUrl: translation ? localePath("fr", "manga", `/blog/${getSlugFromId(translation.post.id)}`) : undefined,
      },
    };
  });
}

const { post, num, minutes, prev, next, translationUrl } = Astro.props;
const { Content, headings } = await render(post);
---

<Post
  title={post.data.title}
  description={post.data.description}
  ogImage={post.data.ogImage?.src}
  date={post.data.date}
  tags={post.data.tags}
  headings={headings}
  num={num}
  minutes={minutes}
  prev={prev}
  next={next}
  translationUrl={translationUrl}
>
  <Content />
</Post>
