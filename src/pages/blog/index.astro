---
import { getCollection } from "astro:content";
import Page from "../../layouts/Page.astro";
import { css } from "../../../styled-system/css";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Page title="Blog - s1m0n3rdx">
  <div class={css({ px: "clamp(14px, 4vw, 40px)" })}>
    <div class={css({ maxW: "container", mx: "auto", py: "12" })}>
      <p class={css({ textStyle: "eyebrow", fontWeight: "600", color: "textMuted", mb: "8" })}>blog</p>

      <div class={css({ display: "flex", flexDir: "column" })}>
        {posts.map(post => (
          <a
            href={`/blog/${post.id}`}
            class={css({ display: "flex", justifyContent: "space-between", alignItems: "baseline", gap: "6", py: "5", borderTop: "1px solid", borderTopColor: "border", _hover: { color: "textMuted" } })}
          >
            <div class={css({ flex: "1", minW: "0" })}>
              <span class={css({ fontFamily: "heading", fontWeight: "500", fontSize: "1rem" })}>{post.data.title}</span>
              <p class={css({ textStyle: "body", color: "textMuted", fontSize: "0.88rem", mt: "1" })}>{post.data.description}</p>
              <div class={css({ display: "flex", gap: "3", mt: "2", flexWrap: "wrap" })}>
                {post.data.tags.map(tag => (
                  <span class={css({ textStyle: "label", color: "textMuted" })}>{tag}</span>
                ))}
              </div>
            </div>
            <span class={css({ textStyle: "label", color: "textMuted", flexShrink: "0" })}>
              {post.data.date.toISOString().split("T")[0]}
            </span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Page>
