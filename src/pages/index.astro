---
import Page from "../layouts/Page.astro";
import { css } from "../../styled-system/css";

const wrap = css({ maxW: "1140px", mx: "auto" });
const eyebrow = css({ textStyle: "eyebrow", color: "textMuted" });
---

<Page title="s1m0n3rdx">

  <!-- TOPBAR -->
  <header class={css({ borderBottom: "1px solid", borderColor: "border", px: "clamp(14px, 4vw, 40px)" })}>
    <div class={css({ maxW: "1140px", mx: "auto", display: "flex", alignItems: "center", justifyContent: "space-between", py: "5" })}>
      <div class={css({ display: "flex", alignItems: "center", gap: "3" })}>
        <span class={css({ w: "34px", h: "34px", rounded: "full", bg: "text", color: "accentFg", display: "grid", placeItems: "center", fontFamily: "mono", fontWeight: "700", fontSize: "sm" })}>
          s
        </span>
        <b class={css({ fontFamily: "heading", fontWeight: "700", fontSize: "1.05rem", letterSpacing: "-0.01em" })}>s1m0n</b>
      </div>
      <span class={css({ fontFamily: "heading", fontWeight: "500", color: "textMuted", fontSize: "0.95rem" })}>
        Developer Portfolio
      </span>
      <button class={css({ w: "34px", h: "34px", rounded: "full", border: "1.5px solid", borderColor: "border", bg: "surface", display: "grid", placeItems: "center", cursor: "pointer" })} aria-label="Search">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      </button>
    </div>
  </header>

  <div class={css({ px: "clamp(14px, 4vw, 40px)" })}>
    <div class={wrap}>

      <!-- HERO -->
      <section class={css({ display: "grid", gridTemplateColumns: "0.85fr 1.6fr", gap: "22px", py: "26px" })}>

        <!-- Left: arrow + hashtags -->
        <div class={css({ display: "flex", flexDir: "column", justifyContent: "flex-end", minH: "340px" })}>
          <svg width="76" height="76" viewBox="0 0 100 100" fill="none" stroke="var(--colors-text)" stroke-width="13" stroke-linecap="square" style="margin-bottom: 26px">
            <path d="M25 25 L75 75"/><path d="M40 78 L78 78 L78 40"/>
          </svg>
          <div class={css({ display: "flex", flexDir: "column" })}>
            {[
              ["#React", "#TypeScript"],
              ["#Node.js", "#PostgreSQL"],
              ["#Docker", "#Astro"],
              ["#UI_Engineering_&_APIs"],
            ].map((row) => (
              <div class={css({ display: "flex", gap: "16px", flexWrap: "wrap", py: "9px", borderTop: "1px solid", borderColor: "border", fontFamily: "mono", fontSize: "0.9rem", fontWeight: "500", _last: { borderBottom: "1px solid", borderBottomColor: "border" } })}>
                {row.map((tag) => (
                  <span>
                    <span class={css({ color: "accent" })}>#</span>
                    {tag.slice(1)}
                  </span>
                ))}
              </div>
            ))}
          </div>
        </div>

        <!-- Right: orange hero panel -->
        <div class={css({ bg: "accent", rounded: "md", minH: "430px", color: "accentFg", p: "6", display: "flex", flexDir: "column", justifyContent: "space-between", position: "relative", overflow: "hidden" })}>
          <div class={css({ fontFamily: "mono", fontSize: "0.82rem", opacity: "0.9" })} id="hero-cmd">
            s1m0n@dev:~$ whoami<span class={css({ display: "inline-block", w: "8px", bg: "accentFg", h: "1em", verticalAlign: "-2px", animation: "blink 1s steps(1) infinite" })}></span>
          </div>
          <div class={css({ fontFamily: "display", color: "accentFg", lineHeight: "0.82", letterSpacing: "-0.02em", fontSize: "clamp(3.2rem, 11vw, 8.6rem)", textTransform: "uppercase", alignSelf: "flex-end", textAlign: "right" })}>
            <span class={css({ fontFamily: "mono", fontWeight: "700", opacity: "0.55", fontSize: "0.42em", verticalAlign: "middle" })}>&lt;</span>
            s1m0n
            <span class={css({ fontFamily: "mono", fontWeight: "700", opacity: "0.55", fontSize: "0.42em", verticalAlign: "middle" })}>/&gt;</span>
          </div>
          <div class={css({ display: "flex", alignItems: "center", justifyContent: "space-between", gap: "12px", mt: "6px" })}>
            <span class={css({ fontFamily: "display", fontSize: "clamp(1.6rem, 4vw, 2.6rem)", bg: "accentFg", color: "accent", display: "inline-block", px: "14px", py: "2px", rounded: "8px", letterSpacing: "0.02em" })}>
              2026
            </span>
            <span class={css({ fontFamily: "mono", fontSize: "0.72rem", opacity: "0.85" })}>
              full-stack · dakar
            </span>
          </div>
        </div>
      </section>

      <!-- SEE MORE -->
      <div class={css({ display: "flex", alignItems: "center", justifyContent: "flex-end", gap: "12px", py: "12px", borderBottom: "1px solid", borderColor: "border" })}>
        <span class={css({ fontFamily: "heading", fontWeight: "600" })}>See more</span>
        <span class={css({ w: "30px", h: "30px", rounded: "full", border: "1.5px solid", borderColor: "border", display: "grid", placeItems: "center", bg: "surface", cursor: "pointer" })}>
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
        </span>
      </div>

      <!-- SECTION NAV -->
      <nav class={css({ display: "flex", alignItems: "center", gap: "26px", py: "16px", borderBottom: "1px solid", borderColor: "border", position: "sticky", top: "0", zIndex: "20" })}>
        <a href="#about" class={css({ fontFamily: "heading", fontWeight: "500", color: "textMuted", pb: "2px", _hover: { color: "text", borderBottom: "2px solid", borderBottomColor: "text" } })}>About</a>
        <a href="#work" class={css({ fontFamily: "heading", fontWeight: "500", color: "textMuted", pb: "2px", _hover: { color: "text", borderBottom: "2px solid", borderBottomColor: "text" } })}>Work</a>
        <a href="/blog" class={css({ fontFamily: "heading", fontWeight: "500", color: "textMuted", pb: "2px", _hover: { color: "text", borderBottom: "2px solid", borderBottomColor: "text" } })}>Blog</a>
      </nav>

      <!-- ABOUT -->
      <section id="about" class={css({ py: "38px", display: "grid", gridTemplateColumns: "1fr 1.35fr", gap: "22px", alignItems: "stretch" })}>

        <!-- Photo / dark card -->
        <div class={css({ rounded: "md", overflow: "hidden", minH: "420px", bg: "text", color: "accentFg", display: "flex", flexDir: "column", justifyContent: "space-between", p: "6" })}>
          <span class={css({ fontFamily: "mono", fontSize: "0.62rem", bg: "rgba(255,255,255,0.15)", px: "9px", py: "4px", rounded: "pill", backdropFilter: "blur(4px)", alignSelf: "flex-end" })}>
            // photo
          </span>
          <div>
            <div class={css({ fontFamily: "body", fontWeight: "500", opacity: "0.75", mb: "1" })}>Hello,</div>
            <div class={css({ fontFamily: "display", fontSize: "clamp(2rem, 5vw, 3.1rem)", lineHeight: "0.95", textTransform: "lowercase" })}>
              i'm <span class={css({ color: "accent" })}>s1m0n</span>
            </div>
            <p class={css({ fontSize: "0.8rem", opacity: "0.8", maxW: "34ch", lineHeight: "1.45", mt: "4" })}>
              Développeur fullstack. Je passe d'un problème à sa solution, de l'API à l'interface.
            </p>
          </div>
        </div>

        <!-- Right col -->
        <div class={css({ display: "flex", flexDir: "column", gap: "22px" })}>

          <!-- Intro card -->
          <div class={css({ bg: "surface", border: "1px solid", borderColor: "border", rounded: "md", p: "6" })}>
            <div class={css({ display: "flex", alignItems: "center", justifyContent: "space-between", mb: "3" })}>
              <h2 class={css({ fontFamily: "heading", fontWeight: "700", fontSize: "1.5rem", letterSpacing: "-0.02em" })}>Introduction</h2>
            </div>
            <h3 class={css({ fontFamily: "heading", fontWeight: "700", fontSize: "1.15rem", mb: "2" })}>Full-Stack Developer</h3>
            <p class={css({ color: "textMuted", fontSize: "0.94rem" })}>
              Je construis des applications de bout en bout - API robuste, interface soignée. J'aborde chaque problème comme un système : lisible, testé, maintenable.
            </p>
          </div>

          <!-- Contact -->
          <div>
            <h2 class={css({ fontFamily: "heading", fontWeight: "700", fontSize: "1.5rem", letterSpacing: "-0.02em", mb: "4" })}>Get in touch</h2>
            <div class={css({ display: "grid", gridTemplateColumns: "repeat(3, 1fr)", gap: "14px" })}>
              <a href="mailto:simondiouf2710@gmail.com" class={css({ bg: "text", color: "accentFg", rounded: "sm", p: "4", minH: "104px", display: "flex", flexDir: "column", justifyContent: "space-between", transition: "transform 0.18s ease", _hover: { transform: "translateY(-3px)" } })}>
                <span class={css({ fontFamily: "mono", fontWeight: "700", fontSize: "1.35rem" })}>@</span>
                <small class={css({ fontFamily: "mono", fontSize: "0.66rem", opacity: "0.85", wordBreak: "break-all" })}>gmail</small>
              </a>
              <a href="https://github.com/s1m0n-d" class={css({ bg: "accent", color: "accentFg", rounded: "sm", p: "4", minH: "104px", display: "flex", flexDir: "column", justifyContent: "space-between", transition: "transform 0.18s ease", _hover: { transform: "translateY(-3px)" } })}>
                <span class={css({ fontFamily: "mono", fontWeight: "700", fontSize: "1.35rem" })}>git</span>
                <small class={css({ fontFamily: "mono", fontSize: "0.66rem", opacity: "0.85", wordBreak: "break-all" })}>github</small>
              </a>
              <a href="https://linkedin.com/in/s1m0n" class={css({ bg: "surface", color: "text", border: "1.5px solid", borderColor: "text", rounded: "sm", p: "4", minH: "104px", display: "flex", flexDir: "column", justifyContent: "space-between", transition: "transform 0.18s ease", _hover: { transform: "translateY(-3px)" } })}>
                <span class={css({ fontFamily: "mono", fontWeight: "700", fontSize: "1.35rem" })}>in</span>
                <small class={css({ fontFamily: "mono", fontSize: "0.66rem", opacity: "0.85", wordBreak: "break-all" })}>linkedin</small>
              </a>
            </div>
          </div>

        </div>
      </section>

      <!-- FOOTER -->
      <footer class={css({ borderTop: "1px solid", borderColor: "border", mt: "20px", py: "44px", display: "flex", alignItems: "center", justifyContent: "space-between", gap: "20px", flexWrap: "wrap" })}>
        <div class={css({ fontFamily: "display", fontSize: "clamp(1.8rem, 6vw, 3.4rem)", textTransform: "uppercase", lineHeight: "0.9" })}>
          Let's build<br />something.
        </div>
        <a href="mailto:simondiouf2710@gmail.com" class={css({ bg: "accent", color: "accentFg", fontFamily: "mono", fontWeight: "500", px: "20px", py: "12px", rounded: "pill", fontSize: "0.82rem" })}>
          simondiouf2710@gmail.com →
        </a>
      </footer>

    </div>
  </div>

</Page>

<script>
  // Typing effect hero (respecte reduced-motion)
  (function () {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const el = document.getElementById("hero-cmd");
    if (!el || reduce) return;
    const full = "s1m0n@dev:~$ whoami";
    const cursor = el.querySelector("span");
    if (!cursor) return;
    el.innerHTML = "";
    el.appendChild(cursor);
    let i = 0;
    const t = setInterval(() => {
      i++;
      el.insertBefore(document.createTextNode(full.slice(0, i)), cursor);
      el.insertBefore(document.createTextNode(""), cursor);
      el.innerHTML = full.slice(0, i) + cursor.outerHTML;
      if (i >= full.length) clearInterval(t);
    }, 55);
  })();
</script>
