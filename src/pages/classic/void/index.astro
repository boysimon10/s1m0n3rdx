---
import { getCollection } from "astro:content";
import Page from "../../../themes/classic/layouts/Page.astro";
import { css } from "../../../../styled-system/css";
import { getSlugFromId } from "../../../i18n";
import { formatDate } from "../../../utils/formatDate";

const entries = (
  await getCollection("void", ({ id, data }) => !data.draft && id.startsWith("en/"))
).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Page title="Void - s1m0n3rdx">
  <div class={css({ px: "clamp(14px, 4vw, 40px)" })}>
    <div class={css({ maxW: "classic", mx: "auto", py: "12" })}>

      <div class={css({ mb: "12" })}>
        <p class={css({ fontFamily: "mono", fontSize: "0.75rem", color: "textMuted", opacity: "0.4", mb: "4" })}>// you're not supposed to be here</p>
        <p class={css({ fontFamily: "mono", fontSize: "0.78rem", color: "textMuted", lineHeight: "1.8" })}>
          <span style="color: var(--colors-accent)">void</span>()<span class={css({ opacity: "0.4" })}> {`{`}</span><br />
          &nbsp;&nbsp;<span class={css({ opacity: "0.5" })}>- no format.</span><br />
          &nbsp;&nbsp;<span class={css({ opacity: "0.5" })}>- no subject.</span><br />
          &nbsp;&nbsp;<span class={css({ opacity: "0.5" })}>- just stuff.</span><br />
          <span class={css({ opacity: "0.4" })}>{`}`}</span>
        </p>
      </div>

      <div class={css({ display: "flex", flexDir: "column" })}>
        {entries.length === 0 && (
          <p class={css({ fontFamily: "mono", fontSize: "0.78rem", color: "textMuted", opacity: "0.4", py: "4" })}>// nothing yet.</p>
        )}
        {entries.map(entry => (
          <a
            href={`/classic/void/${getSlugFromId(entry.id)}`}
            class={css({ display: "flex", justifyContent: "space-between", alignItems: "baseline", gap: "6", py: "5", borderTop: "1px solid", borderTopColor: "border", _hover: { color: "textMuted" } })}
          >
            <div class={css({ flex: "1", minW: "0" })}>
              <span class={css({ fontFamily: "heading", fontWeight: "500", fontSize: "1rem" })}>{entry.data.title}</span>
              <p class={css({ textStyle: "classic.body", color: "textMuted", fontSize: "0.88rem", mt: "1" })}>{entry.data.description}</p>
            </div>
            <span class={css({ fontFamily: "mono", fontSize: "0.75rem", color: "textMuted", opacity: "0.5", flexShrink: "0" })}>
              {formatDate(entry.data.date, "en")}
            </span>
          </a>
        ))}
      </div>

    </div>
  </div>
</Page>
