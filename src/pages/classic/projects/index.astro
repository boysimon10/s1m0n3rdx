---
import Page from "../../../themes/classic/layouts/Page.astro";
import { css } from "../../../../styled-system/css";
import { projects } from "../../../data/projects";
import { getIconSvg } from "../../../utils/icons";
import { getLangFromUrl, useTranslations } from "../../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Page title="Projects - s1m0n3rdx">
  <div class={css({ px: "clamp(14px, 4vw, 40px)" })}>
    <div class={css({ maxW: "classic", mx: "auto", py: "12" })}>
      <p class={css({ textStyle: "classic.eyebrow", fontWeight: "600", color: "textMuted", mb: "8" })}>{t("projects.heading")}</p>

      <div class={css({ display: "flex", flexDir: "column" })}>
        {projects.map(({ num, name, desc, desc_fr, tags, href, year }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class={css({ display: "flex", alignItems: "baseline", gap: "6", py: "6", borderTop: "1px solid", borderTopColor: "border", _hover: { opacity: "0.75" } })}
          >
            <span class={css({ textStyle: "classic.label", color: "accent", flexShrink: "0", w: "6" })}>{num}</span>
            <div class={css({ flex: "1", minW: "0" })}>
              <span class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "1rem" })}>{name}</span>
              <p class={css({ textStyle: "classic.body", color: "textMuted", fontSize: "0.9rem", mt: "1", mb: "3" })}>
                {lang === "fr" && desc_fr ? desc_fr : desc}
              </p>
              <div class={css({ display: "flex", gap: "3", flexWrap: "wrap" })}>
                {tags.map(({ label, icon, iconSource }) => (
                  <span class={css({ display: "inline-flex", alignItems: "center", gap: "1", textStyle: "classic.label", color: "textMuted" })}>
                    <span set:html={getIconSvg(icon, iconSource ?? "dev")} />
                    {label}
                  </span>
                ))}
              </div>
            </div>
            <span class={css({ textStyle: "classic.label", color: "textMuted", flexShrink: "0" })}>{year}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</Page>
