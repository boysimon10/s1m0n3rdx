---
import Base from "../../../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { css } from "../../../../styled-system/css";
import { getIconSvg } from "../../../utils/icons";
import { resolveTagIcon, type TagIconEntry } from "../../../utils/tagIcons";
import { getLangFromUrl, useTranslations } from "../../../i18n";
import { formatDate } from "../../../utils/formatDate";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  tagIcons?: Record<string, TagIconEntry>;
  ogImage?: string;
  translationUrl?: string;
  translationLang?: "en" | "fr";
}

const { title, description, date, tags = [], tagIcons, ogImage, translationUrl, translationLang } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const formattedDate = date ? formatDate(date, lang) : null;
const translationLabel = translationLang === "fr" ? "Lire en français" : "Read in English";
const linkStyleRaw = {
  textStyle: "classic.label",
  color: "textMuted",
  border: "0",
  borderBottom: "1px dashed",
  borderBottomColor: "border",
  _hover: { color: "text", borderBottomColor: "text" },
} as const;
const linkStyle = css(linkStyleRaw);
---

<Base title={title} description={description} ogImage={ogImage} theme="classic">
  <div class={css({ display: "flex", flexDir: "column", minH: "100dvh" })}>
  <Header />
  <main class={css({ flex: "1", px: "clamp(14px, 4vw, 40px)" })}>
    <div class={css({ maxW: "classic", mx: "auto", py: "12" })}>
      <header class={css({ mb: "10", pb: "8", borderBottom: "1px solid", borderBottomColor: "border" })}>
        {formattedDate && (
          <p class={css({ textStyle: "classic.label", color: "textMuted", mb: "3" })}>{formattedDate}</p>
        )}
        <h1 class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "clamp(1.5rem, 4vw, 2rem)", lineHeight: "1.2", letterSpacing: "-0.02em", mb: "3" })}>
          {title}
        </h1>
        {description && (
          <p class={css({ textStyle: "classic.body", color: "textMuted", fontSize: "1rem", lineHeight: "1.55" })}>{description}</p>
        )}
        {tags.length > 0 && (
          <div class={css({ display: "flex", gap: "3", mt: "4", flexWrap: "wrap" })}>
            {tags.map(tag => {
              const iconInfo = resolveTagIcon(tag, tagIcons);
              return (
                <span class={css({ display: "inline-flex", alignItems: "center", gap: "1", textStyle: "classic.label", color: "textMuted" })}>
                  {iconInfo && <span set:html={getIconSvg(iconInfo.icon, iconInfo.iconSource, 13)} />}
                  {tag}
                </span>
              );
            })}
          </div>
        )}
        <div class={css({ display: "flex", gap: "5", mt: "4", flexWrap: "wrap" })}>
          {translationUrl && (
            <a href={translationUrl} class={linkStyle}>
              {translationLabel} →
            </a>
          )}
          <button
            type="button"
            data-share
            data-title={title}
            data-copied={t("post.copied")}
            class={css({ bg: "transparent", p: "0", cursor: "pointer" }, linkStyleRaw)}
          >
            <span data-share-label>{t("post.share")}</span> ↗
          </button>
        </div>
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </main>
  <Footer />
  </div>
</Base>

<script>
  import "../../../scripts/share";
</script>
