---
import Page from "../layouts/Page.astro";
import { css } from "../../../../styled-system/css";
import { getLangFromUrl, useTranslations } from "../../../i18n";
import { music } from "../../../data/music";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const eyebrow = css({ textStyle: "classic.eyebrow", fontWeight: "600", color: "textMuted", mb: "4" });
const row = css({
  display: "flex",
  alignItems: "baseline",
  gap: "4",
  py: "3",
  borderBottom: "1px solid",
  borderBottomColor: "border",
  _hover: { opacity: "0.75" },
});
const meta = css({ textStyle: "classic.label", color: "textMuted", flexShrink: "0" });
const ranges = [
  { value: "short_term", label: t("music.short") },
  { value: "medium_term", label: t("music.medium") },
  { value: "long_term", label: t("music.long") },
];
---

<Page title={lang === "fr" ? "Musique - s1m0n3rdx" : "Music - s1m0n3rdx"}>
  <div class={css({ px: "clamp(14px, 4vw, 40px)" })}>
    <div
      data-music
      data-state="loading"
      data-lang={lang}
      data-label-now={t("music.now")}
      data-label-paused={t("music.paused")}
      data-label-last={t("music.last")}
      class={css({
        maxW: "classic",
        mx: "auto",
        py: "12",
        "&[data-state=loading] [data-skel]": { color: "transparent", bg: "border", animation: "pulse", _motionReduce: { animation: "none" } },
        "&[data-state=loading] a": { pointerEvents: "none" },
        "&[data-state=error] [data-content]": { display: "none" },
        "&:not([data-state=error]) [data-error]": { display: "none" },
      })}
    >
      <p class={eyebrow}>{t("music.heading")}</p>

      <div data-error role="alert" class={css({ py: "6", borderBottom: "1px solid", borderBottomColor: "border" })}>
        <p class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "1.4rem", lineHeight: "1.2", mb: "2" })}>{t("music.oops")}</p>
        <p class={css({ textStyle: "classic.body", color: "textMuted", mb: "4" })}>{t("music.error")}</p>
        <div class={css({ display: "flex", gap: "5", textStyle: "classic.label" })}>
          <button
            type="button"
            data-retry
            class={css({ color: "text", bg: "transparent", border: "none", p: "0", cursor: "pointer", textDecoration: "underline", textDecorationColor: "accent", textUnderlineOffset: "4px" })}
          >
            {t("music.retry")} ↻
          </button>
          <a href={music.profile} target="_blank" rel="noopener noreferrer" class={css({ color: "textMuted", _hover: { color: "text" } })}>{t("music.profile")} ↗</a>
        </div>
      </div>

      <div data-content>
        <section data-now class={css({ py: "6", borderBottom: "1px solid", borderBottomColor: "border" })}>
          <p data-f="label" data-skel class={css({ textStyle: "classic.label", color: "accent", mb: "2", display: "inline-block" })}>{t("music.now")}</p>
          <p class={css({ fontFamily: "heading", fontWeight: "600", fontSize: "1.4rem", lineHeight: "1.2" })}>
            <a data-f="title" data-skel target="_blank" rel="noopener noreferrer" class={css({ _hover: { opacity: "0.75" } })}>Loading a track</a>
          </p>
          <p data-f="artist" data-skel class={css({ textStyle: "classic.body", color: "textMuted", display: "inline-block", mt: "1" })}>Artist name</p>
          <div data-now-progress hidden class={css({ display: "flex", alignItems: "center", gap: "3", mt: "4", textStyle: "classic.label", color: "textMuted" })}>
            <span data-f="elapsed">0:00</span>
            <span class={css({ flex: "1", h: "2px", bg: "border" })}>
              <span data-f="bar" class={css({ display: "block", h: "100%", bg: "accent", transformOrigin: "left", transform: "scaleX(0)", transition: "transform 1s linear" })}></span>
            </span>
            <span data-f="duration">0:00</span>
          </div>
        </section>

        <section class={css({ py: "8" })}>
          <p class={eyebrow}>{t("music.recent")}</p>
          <template data-tpl="recent">
            <a target="_blank" rel="noopener noreferrer" class={row}>
              <span class={css({ flex: "1", minW: "0", truncate: true })}>
                <span data-f="title" data-skel class={css({ fontWeight: "600" })}>Loading a track</span>{" "}
                <span data-f="artist" data-skel class={css({ color: "textMuted" })}>Artist</span>
              </span>
              <span data-f="ago" data-skel class={meta}>5 min ago</span>
            </a>
          </template>
          <div data-list="recent">
            {Array.from({ length: 6 }, () => (
              <a class={row}>
                <span class={css({ flex: "1", minW: "0", truncate: true })}>
                  <span data-skel class={css({ fontWeight: "600" })}>Loading a track</span>
                </span>
                <span data-skel class={meta}>5 min ago</span>
              </a>
            ))}
          </div>
        </section>

        <section class={css({ py: "8" })}>
          <div class={css({ display: "flex", flexWrap: "wrap", justifyContent: "space-between", alignItems: "baseline", gap: "3", mb: "4" })}>
            <p class={css({ textStyle: "classic.eyebrow", fontWeight: "600", color: "textMuted" })}>{t("music.top")}</p>
            <div role="group" aria-label={t("music.top")} class={css({ display: "flex", gap: "4" })}>
              {ranges.map(({ value, label }) => (
                <button
                  type="button"
                  data-range={value}
                  aria-pressed={value === "short_term" ? "true" : "false"}
                  class={css({
                    textStyle: "classic.label",
                    color: "textMuted",
                    bg: "transparent",
                    border: "none",
                    p: "0",
                    cursor: "pointer",
                    _hover: { color: "text" },
                    "&[aria-pressed=true]": { color: "text", textDecoration: "underline", textDecorationColor: "accent", textUnderlineOffset: "4px" },
                  })}
                >
                  {label}
                </button>
              ))}
            </div>
          </div>

          <p class={css({ textStyle: "classic.label", color: "textMuted", mt: "6", mb: "2" })}>{t("music.artists")}</p>
          <template data-tpl="artists">
            <a target="_blank" rel="noopener noreferrer" class={css({ _hover: { opacity: "0.75" } })}>
              <span data-f="name" data-skel>Artist</span>
            </a>
          </template>
          <div data-list="artists" class={css({ display: "flex", flexWrap: "wrap", gap: "2 5", textStyle: "classic.body" })}>
            {Array.from({ length: 5 }, () => <span data-skel>Artist name</span>)}
          </div>

          <p class={css({ textStyle: "classic.label", color: "textMuted", mt: "6", mb: "2" })}>{t("music.tracks")}</p>
          <template data-tpl="tracks">
            <a target="_blank" rel="noopener noreferrer" class={row}>
              <span data-f="rank" class={css({ textStyle: "classic.label", color: "accent", flexShrink: "0" })}>00</span>
              <span class={css({ flex: "1", minW: "0", truncate: true })}>
                <span data-f="title" class={css({ fontWeight: "600" })}>Track</span>{" "}
                <span data-f="artist" class={css({ color: "textMuted" })}>Artist</span>
              </span>
            </a>
          </template>
          <div data-list="tracks">
            {Array.from({ length: 5 }, () => (
              <a class={row}>
                <span data-skel class={css({ flex: "1", fontWeight: "600" })}>Loading a track</span>
              </a>
            ))}
          </div>
        </section>
      </div>

      {music.playlists.length > 0 && (
        <section class={css({ py: "8" })}>
          <p class={eyebrow}>{t("music.playlists")}</p>
          <div class={css({ display: "flex", flexDir: "column", gap: "4" })}>
            {music.playlists.map((id) => (
              <iframe
                src={`https://open.spotify.com/embed/playlist/${id}`}
                title={`Spotify playlist ${id}`}
                loading="lazy"
                allow="clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                class={css({ w: "100%", h: "352px", border: "0" })}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</Page>

<script>
  import "../../../scripts/music";
</script>
