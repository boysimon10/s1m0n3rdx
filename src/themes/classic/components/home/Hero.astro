---
import { css } from "../../../../../styled-system/css";
import { getIconSvg } from "../../../../utils/icons";
import { site, socials, lastPlayed } from "../../../../data/site";
import { getLangFromUrl } from "../../../../i18n";

import IconCopy from "iconoir/icons/regular/copy.svg?raw";

const lang = getLangFromUrl(Astro.url);

const iconMap: Record<string, string> = {
  github: getIconSvg("siGithub", "si"),
  linkedin: getIconSvg("LinkedIn", "dev"),
  x: getIconSvg("siX", "si"),
  instagram: getIconSvg("siInstagram", "si"),
  youtube: getIconSvg("siYoutube", "si"),
  twitch: getIconSvg("siTwitch", "si"),
  mail: getIconSvg("siGmail", "si"),
};

const role = lang === "fr" ? site.role_fr : site.role;
const bio = lang === "fr" ? site.bio_fr : site.bio;

const spotifyTrack = { title: lastPlayed.title, artists: lastPlayed.artist };
---

<section class={css({ py: "10", borderBottom: "1px solid", borderBottomColor: "border" })}>
  <div class={css({ mb: "5" })}>
    <p class={css({ fontFamily: "heading", fontWeight: "700", fontSize: "1.2rem", lineHeight: "1.2", mb: "1" })}>{site.author}</p>
    <div class={css({ display: "flex", alignItems: "center", gap: "2", flexWrap: "wrap" })}>
      <span class={css({ textStyle: "classic.label", color: "textMuted" })}>{role} · {site.location} · {site.email}</span>
      <button
        id="copy-email"
        data-email={site.email}
        aria-label="Copy email"
        class={css({ display: "inline-flex", alignItems: "center", color: "textMuted", _hover: { color: "text" }, transition: "color 0.15s", cursor: "pointer", bg: "transparent", border: "none", p: "0" })}
        set:html={IconCopy}
      />
    </div>
  </div>

  <p class={css({ fontSize: "0.9rem", color: "text", mb: "4", maxW: "520px" })}>{bio}</p>

  <div class={css({ display: "flex", alignItems: "center", gap: "2", mb: "5", fontSize: "0.82rem", color: "textMuted", flexWrap: "wrap" })}>
    <span set:html={getIconSvg("siSpotify", "si", 16)} />
    <span>{lang === "fr" ? "Dernière écoute" : "Last played"}</span>
    <span>-</span>
    <span class={css({ color: "text" })}>{spotifyTrack.title}</span>
    <span>·</span>
    <span>{spotifyTrack.artists}</span>
  </div>

  <div class={css({ display: "flex", alignItems: "center", gap: "4" })}>
    {socials.map(({ href, icon, label }) => (
      <a
        href={href}
        target={href.startsWith("mailto") ? undefined : "_blank"}
        rel={href.startsWith("mailto") ? undefined : "noopener noreferrer"}
        aria-label={label}
        class={css({ display: "flex", alignItems: "center", color: "textMuted", _hover: { color: "text" }, transition: "color 0.15s" })}
        set:html={iconMap[icon]}
      />
    ))}
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email");
  btn?.addEventListener("click", () => {
    const email = btn.dataset.email ?? "";
    navigator.clipboard.writeText(email);
  });
</script>
