---
import { Image } from "astro:assets";
import { site } from "../../../data/site";
import { css } from "../../../../styled-system/css";
import IconRss from "iconoir/icons/regular/rss-feed.svg?raw";
import { getLangFromUrl, getThemeFromUrl, useTranslations, getAlternatePath, getNavLinks, getThemePath, localePath } from "../../../i18n";

const lang = getLangFromUrl(Astro.url);
const theme = getThemeFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const navLinks = getNavLinks(lang, theme);
const homeHref = localePath(lang, theme);

const norm = (p: string) => p.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  href === homeHref
    ? norm(currentPath) === href
    : norm(currentPath) === href || currentPath.startsWith(href + "/");

const enUrl = lang === "fr" ? getAlternatePath(currentPath, "en") : currentPath;
const frUrl = lang === "en" ? getAlternatePath(currentPath, "fr") : currentPath;
const mangaUrl = getThemePath(currentPath, "manga");
const modernUrl = getThemePath(currentPath, "modern");
const classicUrl = getThemePath(currentPath, "classic");
---

<header class={css({ py: "8", textAlign: "center" })}>

  <div class={css({ mb: "4" })}>
    <a href={homeHref}>
      <Image
        src={site.avatar}
        alt="s1m0n"
        width={48}
        height={48}
        densities={[1, 2]}
        loading="eager"
        class={css({ w: "48px", h: "48px", rounded: "full", mx: "auto", display: "block", _hover: { opacity: "0.8" } })}
      />
    </a>
  </div>

  <nav class={css({ display: "flex", flexWrap: "wrap", alignItems: "center", justifyContent: "center", columnGap: { base: "5", sm: "8" }, rowGap: "2", px: "4", mb: "3" })}>
    {navLinks.map(({ labelKey, href }) => (
      <a
        href={href}
        class={css({
          fontFamily: "display",
          fontSize: { base: "1rem", sm: "1.1rem" },
          fontWeight: "700",
          color: "text",
          pb: "1px",
          borderBottom: isActive(href) ? "2px solid" : "2px solid transparent",
          borderBottomColor: isActive(href) ? "text" : "transparent",
          _hover: { borderBottomColor: "text" },
        })}
      >
        {t(labelKey)}
      </a>
    ))}
    <a
      href={lang === "fr" ? "/fr/rss.xml" : "/rss.xml"}
      class={css({ display: "flex", alignItems: "center", color: "textMuted", _hover: { color: "text" } })}
      aria-label="RSS"
    >
      <span class={css({ w: "18px", h: "18px", display: "flex" })} set:html={IconRss} />
    </a>
  </nav>

  <div class={css({ display: "flex", alignItems: "center", justifyContent: "center", gap: "4" })}>
    <a href={enUrl} class={css({ textStyle: "classic.label", color: lang === "en" ? "accent" : "textMuted", _hover: { color: "text" } })}>EN</a>
    <a href={frUrl} class={css({ textStyle: "classic.label", color: lang === "fr" ? "accent" : "textMuted", _hover: { color: "text" } })}>FR</a>
    <span class={css({ textStyle: "classic.label", color: "border" })}>|</span>
    <a href={mangaUrl} title={t("theme.manga")} class={css({ textStyle: "classic.label", color: "textMuted", _hover: { color: "text" } })}>manga</a>
    <a href={modernUrl} title={t("theme.modern")} class={css({ textStyle: "classic.label", color: theme === "modern" ? "accent" : "textMuted", _hover: { color: "text" } })}>modern</a>
    <a href={classicUrl} title={t("theme.classic")} class={css({ textStyle: "classic.label", color: theme === "classic" ? "accent" : "textMuted", _hover: { color: "text" } })}>classic</a>
  </div>

</header>
