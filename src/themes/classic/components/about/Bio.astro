---
import { css } from "../../../../../styled-system/css";
import { getLangFromUrl, useTranslations } from "../../../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class={css({ py: "8", borderBottom: "1px solid", borderBottomColor: "border" })}>
  <p class={css({ textStyle: "classic.body", lineHeight: "1.75", mb: "4" })}>{t("about.p1")}</p>
  <p class={css({ textStyle: "classic.body", lineHeight: "1.75", color: "textMuted" })}>{t("about.p2")}</p>
</div>
