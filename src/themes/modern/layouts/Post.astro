---
import Page from "./Page.astro";
import Tag from "../components/Tag.astro";
import { css, cx } from "../../../../styled-system/css";
import { resolveTagIcon, type TagIconEntry } from "../../../utils/tagIcons";
import { getLangFromUrl, localePath, useTranslations } from "../../../i18n";
import { formatDate } from "../../../utils/formatDate";
import IconArrowRight from "iconoir/icons/regular/arrow-right.svg?raw";

interface Props {
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  tagIcons?: Record<string, TagIconEntry>;
  ogImage?: string;
  translationUrl?: string;
  translationLang?: "en" | "fr";
  variant?: "article" | "void";
}

const { title, description, date, tags = [], tagIcons, ogImage, translationUrl, translationLang, variant = "article" } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isVoid = variant === "void";
const translationLabel = translationLang === "fr" ? "Lire en français" : "Read in English";
const hasAside = isVoid || tags.length > 0 || !!translationUrl;
---

<Page title={title} description={description} ogImage={ogImage}>
  <div class={css({ display: "flex", flexDir: "column", gap: "clamp(28px, 4vw, 44px)" })}>
    <header class={css({ display: "flex", flexDir: "column", gap: "18px", maxW: "920px" })}>
      {date && (
        <span
          class={cx(
            css({ alignSelf: "flex-start", py: "7px", px: "12px", rounded: "pill", fontFamily: "mono", fontWeight: "500", fontSize: "12.5px", lineHeight: "1" }),
            isVoid ? css({ border: "1.5px dashed {colors.border}" }) : css({ border: "1.5px solid {colors.border}" }),
          )}
        >
          {formatDate(date, lang)}
        </span>
      )}
      <h1
        class={cx(
          css({ m: "0", textWrap: "balance" }),
          isVoid
            ? css({ fontFamily: "mono", fontWeight: "500", fontSize: "clamp(2rem, 5.4vw, 3.6rem)", lineHeight: "1.08", letterSpacing: "-0.04em" })
            : css({ textStyle: "h1" }),
        )}
      >
        {title}
      </h1>
      {description && (
        <p class={css({ m: "0", maxW: "60ch", fontFamily: "body", fontSize: "clamp(1.125rem, 2vw, 1.375rem)", lineHeight: "1.45", color: "textMuted", textWrap: "pretty" })}>
          {description}
        </p>
      )}
    </header>

    <div class={css({ display: "flex", flexWrap: "wrap", gap: "clamp(24px, 5vw, 64px)", alignItems: "flex-start" })}>
      {hasAside && (
        isVoid ? (
          <aside
            class={css({
              flex: "1 1 260px",
              maxW: "100%",
              display: "flex",
              alignItems: "center",
              justifyContent: "space-between",
              gap: "12px",
              py: "16px",
              px: "20px",
              border: "1.5px dashed {colors.border}",
              rounded: "lg",
            })}
          >
            <span class={css({ py: "6px", px: "10px", rounded: "pill", bg: "text", color: "accent", fontFamily: "mono", fontWeight: "500", fontSize: "12px", lineHeight: "1" })}>
              void()
            </span>
            <a href={localePath(lang, "modern", "/void")} class={css({ fontFamily: "mono", fontSize: "12px", lineHeight: "1", color: "textMuted", _hover: { color: "text" } })}>
              {t("void.back")}
            </a>
          </aside>
        ) : (
          <aside
            class={css({
              flex: "1 1 260px",
              maxW: "100%",
              display: "flex",
              flexDir: "column",
              gap: "16px",
              p: "20px",
              border: "1.5px solid {colors.border}",
              rounded: "lg",
              bg: "surfaceAlt",
            })}
          >
            {tags.length > 0 && (
              <div class={css({ display: "flex", flexWrap: "wrap", gap: "6px" })}>
                {tags.map((tag) => {
                  const info = resolveTagIcon(tag, tagIcons);
                  return <Tag label={tag} icon={info?.icon} iconSource={info?.iconSource} surface />;
                })}
              </div>
            )}
            {translationUrl && (
              <a
                href={translationUrl}
                class={css({
                  display: "flex",
                  justifyContent: "space-between",
                  alignItems: "center",
                  gap: "12px",
                  py: "6px",
                  pr: "6px",
                  pl: "16px",
                  rounded: "pill",
                  bg: "text",
                  color: "inverse",
                  fontFamily: "mono",
                  fontWeight: "500",
                  fontSize: "13px",
                  lineHeight: "1",
                })}
              >
                {translationLabel}
                <span
                  class={css({ w: "32px", h: "32px", rounded: "full", bg: "accent", color: "text", display: "grid", placeItems: "center", "& svg": { w: "15px", h: "15px" } })}
                  set:html={IconArrowRight}
                />
              </a>
            )}
          </aside>
        )
      )}
      <article class={cx("prose-modern", css({ flex: "999 1 560px", minW: "0", maxW: "prose" }))}>
        <slot />
      </article>
    </div>
  </div>
</Page>
