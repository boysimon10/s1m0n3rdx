---
import Base from "../../../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { css } from "../../../../styled-system/css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage} theme="modern">
  <div
    class={css({
      maxW: "container",
      mx: "auto",
      pt: "clamp(12px, 2vw, 24px)",
      px: "clamp(16px, 4vw, 48px)",
      pb: "clamp(16px, 3vw, 32px)",
      display: "flex",
      flexDir: "column",
      gap: "clamp(28px, 4vw, 48px)",
    })}
  >
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </div>
</Base>
