---
import { css, cx } from "../../../../../styled-system/css";
import { getIconSvg } from "../../../../utils/icons";
import { site, socials, lastPlayed } from "../../../../data/site";
import { getLangFromUrl, useTranslations } from "../../../../i18n";
import Diamond from "../Diamond.astro";
import IconCopy from "iconoir/icons/regular/copy.svg?raw";
import IconLinkedin from "iconoir/icons/regular/linkedin.svg?raw";
import IconMail from "iconoir/icons/regular/mail.svg?raw";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const role = lang === "fr" ? site.role_fr : site.role;
const bio = lang === "fr" ? site.bio_fr : site.bio;
const firstName = site.author.split(" ")[0];

// brand icons get recolored to ink; iconoir icons are stroke-based and must keep fill: none
const socialIcons: Record<string, { svg: string; brand: boolean }> = {
  github: { svg: getIconSvg("siGithub", "si", 22), brand: true },
  linkedin: { svg: IconLinkedin, brand: false },
  x: { svg: getIconSvg("siX", "si", 22), brand: true },
  instagram: { svg: getIconSvg("siInstagram", "si", 22), brand: true },
  youtube: { svg: getIconSvg("siYoutube", "si", 22), brand: true },
  twitch: { svg: getIconSvg("siTwitch", "si", 22), brand: true },
  mail: { svg: IconMail, brand: false },
};

const card = css({ border: "1.5px solid {colors.border}", rounded: "lg" });
const pill = css({ fontFamily: "mono", fontWeight: "500", fontSize: "13px", lineHeight: "1", rounded: "pill" });
const outlined = css({ display: "inline-flex", alignItems: "center", gap: "8px", py: "10px", px: "16px", border: "1.5px solid {colors.border}" });
---

<section class={css({ display: "flex", flexDir: "column", gap: "16px" })}>
  <div class={cx(card, css({ display: "flex", flexDir: "column", gap: "24px", p: "clamp(20px, 3vw, 32px)", bg: "surface" }))}>
    <h1 class={css({ textStyle: "h1", m: "0" })}>{t("hero.greeting")} {firstName}</h1>
    <div class={css({ display: "flex", flexWrap: "wrap", gap: "8px", alignItems: "center" })}>
      <span class={cx(pill, css({ py: "11px", px: "16px", bg: "text", color: "inverse" }))}>{role}</span>
      <span class={cx(pill, outlined)}>
        <Diamond />
        {site.location}
      </span>
      <span
        class={cx(
          pill,
          css({ display: "inline-flex", alignItems: "center", gap: "10px", py: "4px", pr: "4px", pl: "16px", border: "1.5px solid {colors.border}", bg: "surface" }),
        )}
      >
        {site.email}
        <button
          id="copy-email"
          type="button"
          data-email={site.email}
          title={t("hero.copy")}
          aria-label={t("hero.copy")}
          class={css({
            w: "34px",
            h: "34px",
            rounded: "full",
            border: "1.5px solid {colors.border}",
            bg: "accent",
            display: "grid",
            placeItems: "center",
            cursor: "pointer",
            p: "0",
            color: "text",
            transition: "background 0.15s",
            _hover: { bg: "text", color: "inverse" },
            "& svg": { w: "16px", h: "16px" },
          })}
          set:html={IconCopy}
        />
      </span>
      <span class={cx(pill, outlined)}>
        <span class={css({ display: "flex" })} set:html={getIconSvg("siSpotify", "si", 16)} />
        <span class={css({ display: "none", color: "textMuted", sm: { display: "inline" } })}>{t("hero.lastPlayed")} —</span>
        {lastPlayed.title}
        <span class={css({ color: "textMuted" })}>· {lastPlayed.artist}</span>
      </span>
      <span id="copy-email-done" hidden class={css({ fontFamily: "mono", fontWeight: "500", fontSize: "12px", color: "textMuted" })}>
        {t("hero.copied")}
      </span>
    </div>
  </div>

  <div class={css({ display: "flex", flexWrap: "wrap", gap: "16px" })}>
    <p class={cx(card, css({ flex: "2 1 460px", m: "0", p: "clamp(20px, 3vw, 32px)", bg: "surface", textStyle: "lead", textWrap: "pretty" }))}>{bio}</p>
    <div
      class={cx(
        card,
        css({ flex: "1 1 300px", p: "16px", bg: "surface", display: "flex", flexWrap: "wrap", gap: "10px", alignContent: "center", justifyContent: "center" }),
      )}
    >
      {socials.map(({ href, icon, label }) => {
        const entry = socialIcons[icon];
        const external = !href.startsWith("mailto");
        return (
          <a
            href={href}
            target={external ? "_blank" : undefined}
            rel={external ? "noopener noreferrer" : undefined}
            aria-label={label}
            title={label}
            class={cx(
              css({
                w: "52px",
                h: "52px",
                rounded: "full",
                border: "1.5px solid {colors.border}",
                bg: "bg",
                color: "text",
                display: "grid",
                placeItems: "center",
                transition: "background 0.15s",
                _hover: { bg: "accent" },
                "& svg": { w: "22px", h: "22px" },
              }),
              entry?.brand && css({ "& svg": { fill: "currentColor" } }),
            )}
            set:html={entry?.svg ?? ""}
          />
        );
      })}
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email");
  const done = document.getElementById("copy-email-done");
  let timer: ReturnType<typeof setTimeout>;
  btn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(btn.dataset.email ?? "");
    if (!done) return;
    done.hidden = false;
    clearTimeout(timer);
    timer = setTimeout(() => (done.hidden = true), 1600);
  });
</script>
