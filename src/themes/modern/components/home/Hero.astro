---
import { css, cx } from "../../../../../styled-system/css";
import { getIconSvg } from "../../../../utils/icons";
import { site, lastPlayed } from "../../../../data/site";
import { getLangFromUrl, useTranslations } from "../../../../i18n";
import SocialLinks from "../SocialLinks.astro";
import IconCopy from "iconoir/icons/regular/copy.svg?raw";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const role = lang === "fr" ? site.role_fr : site.role;
const bio = lang === "fr" ? site.bio_fr : site.bio;
const firstName = site.author.split(" ")[0];

const card = css({ border: "1.5px solid {colors.border}", rounded: "lg" });
const pill = css({ fontFamily: "mono", fontWeight: "500", fontSize: "13px", lineHeight: "1", rounded: "pill" });
const outlined = css({ display: "inline-flex", alignItems: "center", gap: "8px", py: "10px", px: "16px", border: "1.5px solid {colors.border}" });
---

<section class={css({ display: "flex", flexDir: "column", gap: "16px" })}>
  <div class={cx(card, css({ display: "flex", flexDir: "column", gap: "24px", p: "clamp(20px, 3vw, 32px)", bg: "surface" }))}>
    <h1 class={css({ textStyle: "h1", m: "0" })}>{t("hero.greeting")} {firstName}</h1>
    <div class={css({ display: "flex", flexWrap: "wrap", gap: "8px", alignItems: "center" })}>
      <span class={cx(pill, css({ py: "11px", px: "16px", bg: "text", color: "inverse" }))}>{role}</span>
      <span class={cx(pill, outlined)}>{site.location}</span>
      <span
        class={cx(
          pill,
          css({ display: "inline-flex", alignItems: "center", gap: "10px", py: "4px", pr: "4px", pl: "16px", border: "1.5px solid {colors.border}", bg: "surface" }),
        )}
      >
        {site.email}
        <button
          id="copy-email"
          type="button"
          data-email={site.email}
          title={t("hero.copy")}
          aria-label={t("hero.copy")}
          class={css({
            w: "34px",
            h: "34px",
            rounded: "full",
            border: "1.5px solid {colors.border}",
            bg: "accent",
            display: "grid",
            placeItems: "center",
            cursor: "pointer",
            p: "0",
            color: "text",
            transition: "background 0.15s",
            _hover: { bg: "text", color: "inverse" },
            "& svg": { w: "16px", h: "16px" },
          })}
          set:html={IconCopy}
        />
      </span>
      <a
        id="spotify-pill"
        target="_blank"
        rel="noopener noreferrer"
        data-now={t("hero.nowPlaying")}
        data-last={t("hero.lastPlayed")}
        data-loading
        class={cx(
          pill,
          outlined,
          css({
            transition: "background 0.15s, opacity 0.2s",
            "&[href]:hover": { bg: "accentSoft" },
            "&[data-loading]": { visibility: "hidden", opacity: "0" },
          }),
        )}
      >
        <span class={css({ display: "flex" })} set:html={getIconSvg("siSpotify", "si", 16)} />
        <span data-sp-label class={css({ display: "none", color: "textMuted", sm: { display: "inline" } })}>{t("hero.lastPlayed")} ·</span>
        <span data-sp-title>{lastPlayed.title}</span>
        <span data-sp-artist class={css({ color: "textMuted" })}>· {lastPlayed.artist}</span>
      </a>
      <noscript><style is:inline>#spotify-pill { visibility: visible; opacity: 1; }</style></noscript>
      <span id="copy-email-done" hidden class={css({ fontFamily: "mono", fontWeight: "500", fontSize: "12px", color: "textMuted" })}>
        {t("hero.copied")}
      </span>
    </div>
  </div>

  <div class={css({ display: "flex", flexWrap: "wrap", gap: "16px" })}>
    <p class={cx(card, css({ flex: "2 1 460px", m: "0", p: "clamp(20px, 3vw, 32px)", bg: "surface", textStyle: "lead", textWrap: "pretty" }))}>{bio}</p>
    <div
      class={cx(
        card,
        css({ flex: "1 1 300px", p: "16px", bg: "surface", display: "flex", flexWrap: "wrap", gap: "10px", alignContent: "center", justifyContent: "center" }),
      )}
    >
      <SocialLinks />
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("copy-email");
  const done = document.getElementById("copy-email-done");
  let timer: ReturnType<typeof setTimeout>;
  btn?.addEventListener("click", async () => {
    await navigator.clipboard.writeText(btn.dataset.email ?? "");
    if (!done) return;
    done.hidden = false;
    clearTimeout(timer);
    timer = setTimeout(() => (done.hidden = true), 1600);
  });

  import type { NowPlaying } from "../../../../../worker/index";


  const pill = document.getElementById("spotify-pill") as HTMLAnchorElement | null;
  const REFRESH_MS = 30_000;
  const TIMEOUT_MS = 5_000;

  async function refresh(el: HTMLAnchorElement) {
    try {
      const res = await fetch("/api/now-playing", { cache: "no-store", signal: AbortSignal.timeout(TIMEOUT_MS) });
      if (!res.ok) return;
      const track = (await res.json()) as NowPlaying;
      if (!track) return;
      const set = (selector: string, text: string) => {
        const node = el.querySelector(selector);
        if (node) node.textContent = text;
      };
      el.href = track.url;
      set("[data-sp-title]", track.title);
      set("[data-sp-artist]", `· ${track.artist}`);
      set("[data-sp-label]", `${track.playing ? el.dataset.now : el.dataset.last} ·`);
    } catch {
    } finally {
      delete el.dataset.loading;
    }
  }

  if (pill) {
    void refresh(pill);
    setInterval(() => {
      if (document.visibilityState === "visible") void refresh(pill);
    }, REFRESH_MS);
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible") void refresh(pill);
    });
  }
</script>
