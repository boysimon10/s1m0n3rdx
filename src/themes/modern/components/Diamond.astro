---
import { css, cx } from "../../../../styled-system/css";

interface Props {
  size?: 6 | 7 | 8 | 10 | 11;
  outlined?: boolean;
  class?: string;
}

const { size = 8, outlined = false, class: className } = Astro.props;

const sizes = {
  6: css({ w: "6px", h: "6px" }),
  7: css({ w: "7px", h: "7px" }),
  8: css({ w: "8px", h: "8px" }),
  10: css({ w: "10px", h: "10px" }),
  11: css({ w: "11px", h: "11px" }),
};
---

<span
  aria-hidden="true"
  class={cx(
    css({ display: "inline-block", flex: "none", bg: "accent", transform: "rotate(45deg)" }),
    outlined && css({ border: "1.5px solid {colors.border}" }),
    sizes[size],
    className,
  )}
></span>
