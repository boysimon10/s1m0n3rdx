---
import { css, cx } from "../../../../styled-system/css";
import { getIconSvg } from "../../../utils/icons";
import { socials } from "../../../data/site";
import IconLinkedin from "iconoir/icons/regular/linkedin.svg?raw";
import IconMail from "iconoir/icons/regular/mail.svg?raw";

// brand icons get recolored to ink; iconoir icons are stroke-based and must keep fill: none
const socialIcons: Record<string, { svg: string; brand: boolean }> = {
  github: { svg: getIconSvg("siGithub", "si", 22), brand: true },
  linkedin: { svg: IconLinkedin, brand: false },
  x: { svg: getIconSvg("siX", "si", 22), brand: true },
  instagram: { svg: getIconSvg("siInstagram", "si", 22), brand: true },
  youtube: { svg: getIconSvg("siYoutube", "si", 22), brand: true },
  twitch: { svg: getIconSvg("siTwitch", "si", 22), brand: true },
  mail: { svg: IconMail, brand: false },
};
---

{socials.map(({ href, icon, label }) => {
  const entry = socialIcons[icon];
  const external = !href.startsWith("mailto");
  return (
    <a
      href={href}
      target={external ? "_blank" : undefined}
      rel={external ? "noopener noreferrer" : undefined}
      aria-label={label}
      title={label}
      class={cx(
        css({
          w: "52px",
          h: "52px",
          rounded: "full",
          border: "1.5px solid {colors.border}",
          bg: "bg",
          color: "text",
          display: "grid",
          placeItems: "center",
          transition: "background 0.15s",
          _hover: { bg: "accent" },
          "& svg": { w: "22px", h: "22px" },
        }),
        entry?.brand && css({ "& svg": { fill: "currentColor" } }),
      )}
      set:html={entry?.svg ?? ""}
    />
  );
})}
