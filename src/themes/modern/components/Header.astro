---
import { Image } from "astro:assets";
import { css, cx } from "../../../../styled-system/css";
import IconRss from "iconoir/icons/regular/rss-feed.svg?raw";
import { site } from "../../../data/site";
import {
  getLangFromUrl,
  useTranslations,
  getAlternatePath,
  getNavLinks,
  getThemePath,
  localePath,
} from "../../../i18n";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const currentPath = Astro.url.pathname;
const navLinks = getNavLinks(lang, "modern");
const homeHref = localePath(lang, "modern");

const norm = (p: string) => p.replace(/\/$/, "") || "/";
const matches = (href: string) => norm(currentPath) === href || currentPath.startsWith(href + "/");
const blogHref = localePath(lang, "modern", "/blog");
const voidHref = localePath(lang, "modern", "/void");
const isActive = (href: string) => {
  if (href === homeHref) return norm(currentPath) === href;
  if (href === blogHref) return matches(href) || matches(voidHref);
  return matches(href);
};

const langs = [
  { code: "EN", active: lang === "en", href: lang === "fr" ? getAlternatePath(currentPath, "en") : currentPath },
  { code: "FR", active: lang === "fr", href: lang === "en" ? getAlternatePath(currentPath, "fr") : currentPath },
];
const mangaUrl = getThemePath(currentPath, "manga");
const classicUrl = getThemePath(currentPath, "classic");
const rssHref = lang === "fr" ? "/fr/rss.xml" : "/rss.xml";

const line = css({ display: "none", md: { display: "block", flex: "1", h: "1.5px", bg: "border", minW: "16px" } });
const circle = css({
  display: "grid",
  placeItems: "center",
  rounded: "full",
  fontFamily: "mono",
  fontWeight: "500",
  fontSize: "11px",
  lineHeight: "1",
  w: "24px",
  h: "24px",
});
---

<header
  class={css({
    display: "flex",
    flexWrap: "wrap",
    alignItems: "center",
    gap: "10px",
    md: {
      flexWrap: "nowrap",
      gap: "12px",
      p: "8px",
      border: "1.5px solid {colors.border}",
      rounded: "pill",
      bg: "surface",
    },
  })}
>
  <a href={homeHref} aria-label={site.author} class={css({ display: "flex", flex: "none", order: "1", md: { order: "0" } })}>
    <Image
      src={site.avatar}
      alt=""
      width={44}
      height={44}
      densities={[1, 2]}
      loading="eager"
      class={css({
        w: "44px",
        h: "44px",
        rounded: "full",
        border: "1.5px solid {colors.border}",
        bg: "accent",
        objectFit: "cover",
        transition: "opacity 0.15s",
        _hover: { opacity: "0.8" },
      })}
    />
  </a>

  <span class={line}></span>

  <nav
    class={css({
      order: "3",
      flexBasis: "100%",
      display: "flex",
      alignItems: "center",
      gap: "2px",
      p: "4px",
      border: "1.5px solid {colors.border}",
      rounded: "pill",
      bg: "surface",
      md: { order: "0", flexBasis: "auto", gap: "4px", p: "0", border: "none", bg: "transparent" },
    })}
  >
    {navLinks.map(({ labelKey, href }) => (
      <a
        href={href}
        aria-current={isActive(href) ? "page" : undefined}
        class={cx(
          css({
            flex: "1",
            textAlign: "center",
            py: "13px",
            px: "4px",
            rounded: "pill",
            textStyle: "nav",
            fontSize: "14px",
            whiteSpace: "nowrap",
            transition: "background 0.15s",
            md: { flex: "none", py: "12px", px: "18px", fontSize: "15px" },
          }),
          isActive(href) ? css({ bg: "text", color: "inverse" }) : css({ _hover: { bg: "surfaceAlt" } }),
        )}
      >
        {t(labelKey)}
      </a>
    ))}
    <a
      href={rssHref}
      aria-label="RSS"
      class={css({
        flex: "none",
        w: "40px",
        h: "40px",
        ml: "4px",
        rounded: "full",
        border: "1.5px solid {colors.border}",
        display: "grid",
        placeItems: "center",
        transition: "background 0.15s",
        _hover: { bg: "accent" },
        "& svg": { w: "18px", h: "18px" },
      })}
      set:html={IconRss}
    />
  </nav>

  <span class={line}></span>

  <div class={css({ order: "2", ml: "auto", display: "flex", alignItems: "center", gap: "8px", md: { order: "0", ml: "0", gap: "12px" } })}>
    <div class={css({ display: "flex", alignItems: "center", gap: "5px", fontFamily: "mono", fontWeight: "500", fontSize: "11px", color: "textMuted" })}>
      <span class={css({ display: "none", md: { display: "inline" } })}>{t("theme.label")}</span>
      <a
        href={mangaUrl}
        title={t("theme.manga")}
        class={cx(circle, css({ border: "1px solid {colors.hairline}", color: "textMuted", _hover: { borderColor: "border", color: "text" } }))}
      >
        1
      </a>
      <span class={cx(circle, css({ bg: "text", color: "inverse" }))} title={t("theme.modern")}>2</span>
      <a
        href={classicUrl}
        title={t("theme.classic")}
        class={cx(circle, css({ border: "1px solid {colors.hairline}", color: "textMuted", _hover: { borderColor: "border", color: "text" } }))}
      >
        3
      </a>
    </div>

    <div class={css({ display: "flex", p: "3px", gap: "2px", border: "1.5px solid {colors.border}", rounded: "pill" })}>
      {langs.map(({ code, active, href }) => (
        <a
          href={href}
          aria-current={active ? "true" : undefined}
          class={cx(
            css({ py: "11px", px: "11px", rounded: "pill", fontFamily: "mono", fontSize: "12px", lineHeight: "1", md: { py: "9px", px: "12px" } }),
            active
              ? css({ bg: "accent", border: "1.5px solid {colors.border}", fontWeight: "600" })
              : css({ border: "1.5px solid transparent", fontWeight: "500", color: "textMuted", _hover: { color: "text" } }),
          )}
        >
          {code}
        </a>
      ))}
    </div>
  </div>
</header>
