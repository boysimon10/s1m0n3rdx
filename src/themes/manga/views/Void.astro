---
import { getCollection } from "astro:content";
import Page from "../layouts/Page.astro";
import Sfx from "../components/Sfx.astro";
import { css, cx } from "../../../../styled-system/css";
import { getLangFromUrl, getSlugFromId, localePath, useTranslations } from "../../../i18n";
import { formatDate } from "../../../utils/formatDate";
import { inkPanel, pageTitle } from "../styles";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const entries = (await getCollection("void", ({ id, data }) => !data.draft && id.startsWith(`${lang}/`))).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

// four panel styles, cycled so the wall of notes doesn't look like a list
const variants = [
  { box: css({ bg: "surface" }), text: css({ fontWeight: "700", fontSize: "clamp(22px, 2.2vw, 26px)", lineHeight: "1.2" }) },
  { box: css({ bg: "surface" }), text: css({ fontWeight: "400", fontSize: "17px", lineHeight: "1.5" }) },
  {
    box: css({ bg: "surface", backgroundImage: "radial-gradient(color-mix(in srgb, var(--colors-accent) 55%, transparent) 1.3px, transparent 1.6px)", backgroundSize: "7px 7px" }),
    text: css({ alignSelf: "flex-start", bg: "surface", py: "2px", px: "6px", fontWeight: "800", fontSize: "22px", lineHeight: "1.25" }),
  },
  { box: css({ bg: "text", color: "inverse", boxShadow: "6px 6px 0 {colors.accent}" }), text: css({ fontFamily: "sfx", fontSize: "clamp(26px, 3vw, 34px)", lineHeight: "1.05" }) },
];
---

<Page title="Void">
  <div class={css({ display: "flex", flexDir: "column", gap: "24px" })}>
    <div class={cx(inkPanel, css({ position: "relative", overflow: "hidden", display: "flex", justifyContent: "space-between", alignItems: "flex-end", gap: "16px", py: "clamp(26px, 3vw, 36px)", px: "clamp(22px, 3.4vw, 40px)" }))}>
      <div class={css({ position: "absolute", inset: "0", backgroundImage: "radial-gradient(color-mix(in srgb, var(--colors-inverse) 22%, transparent) 1px, transparent 1.3px)", backgroundSize: "6px 6px", maskImage: "linear-gradient(90deg, transparent 30%, #000)" })}></div>
      <div class={css({ position: "relative", display: "flex", flexDir: "column", gap: "10px" })}>
        <span class={css({ fontFamily: "mono", fontWeight: "500", fontSize: "13px", lineHeight: "1", color: "manga.redLight" })}>{t("manga.monologue")}</span>
        <h1 class={pageTitle}>Void</h1>
      </div>
      <Sfx text="ゴゴゴ" size="clamp(36px, 5vw, 64px)" rotate={-5} tone="plain" class={css({ position: "relative" })} />
    </div>

    <p class={css({ m: "0", fontFamily: "mono", fontSize: "13px", color: "textMuted" })}>{t("void.comment")}</p>

    {entries.length === 0 ? (
      <p class={css({ m: "0", fontFamily: "mono", fontSize: "13px", color: "textMuted" })}>{t("void.empty")}</p>
    ) : (
      <div class={css({ columns: "1", columnGap: "12px", sm: { columns: "2" }, lg: { columns: "3" } })}>
        {entries.map((entry, i) => {
          const v = variants[i % variants.length];
          return (
            <a
              href={localePath(lang, "manga", `/void/${getSlugFromId(entry.id)}`)}
              class={cx(
                css({ breakInside: "avoid", display: "flex", flexDir: "column", gap: "12px", mb: "12px", p: "20px", border: "3px solid {colors.border}", transition: "transform 0.15s", _hover: { transform: "translate(-2px, -2px)" } }),
                v?.box,
              )}
            >
              <span class={css({ fontFamily: "mono", fontWeight: "500", fontSize: "11px", lineHeight: "1", opacity: "0.7" })}>{formatDate(entry.data.date, lang)}</span>
              <span class={cx(css({ textWrap: "pretty" }), v?.text)}>{entry.data.title}</span>
              {i % variants.length === 1 && <span class={css({ fontSize: "15px", lineHeight: "1.5", color: "textBody" })}>{entry.data.description}</span>}
            </a>
          );
        })}
      </div>
    )}
  </div>
</Page>
