---
import Base from "../../../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { css } from "../../../../styled-system/css";

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  published?: Date;
}

const { title, description, ogImage, published } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage} published={published} theme="manga">
  <div
    class={css({
      maxW: "container",
      mx: "auto",
      pt: "clamp(14px, 2vw, 24px)",
      px: "clamp(16px, 4vw, 48px)",
      pb: "clamp(24px, 3vw, 40px)",
      display: "flex",
      flexDir: "column",
      gap: "clamp(14px, 2.4vw, 28px)",
      minH: "100dvh",
    })}
  >
    <Header />
    <main class={css({ flex: "1" })}>
      <slot />
    </main>
    <Footer />
  </div>
</Base>
